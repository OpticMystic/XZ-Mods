      "parser": "native_export",
      "parser_version": 1,
      "categories": [
        "bridge",
        "audio",
        "display",
        "app_usb",
        "other"
      ],
      "max_read_bytes": 524288,
      "time_basis": "unknown",
      "safe_fields": [
        "code",
        "state",
        "attempt",
        "retryable",
        "route_ready",
        "result",
        "slot",
        "elapsed_ms"
