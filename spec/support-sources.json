      "safe_fields": [
        "code",
        "state",
        "attempt",
        "retryable",
        "route_ready",
        "result",
        "slot",
        "elapsed_ms"
      ]
    },
    {
      "source_id": "application_output",
      "location": "xz",
      "path": "/tmp/xz_rbp.log",
      "parser": "exit_codes",
      "parser_version": 1,
      "categories": [
