        "other"
      ],
      "max_read_bytes": 131072,
      "time_basis": "unknown",
      "safe_fields": [
        "error_namespace",
        "error_code"
      ]
    },
    {
      "source_id": "receiver",
      "location": "xz",
      "path": "/tmp/xz_directfb_hook.log",
      "parser": "events",
      "parser_version": 1,
      "categories": [
        "display"
      ],
      "max_read_bytes": 131072,
      "time_basis": "unknown",
      "safe_fields": [
        "code",
        "state",
        "attempt",
        "retryable",
        "route_ready",
        "result",
