      "parser": "events",
      "parser_version": 1,
      "categories": [
        "bridge",
        "audio",
        "display",
        "app_usb",
        "other"
      ],
      "max_read_bytes": 131072,
      "time_basis": "device_local_unknown",
      "safe_fields": [
        "code",
        "state",
        "attempt",
        "retryable",
        "route_ready",
        "result",
        "slot",
        "elapsed_ms"
      ]
    },
    {
      "source_id": "native_export",
      "location": "usb",
