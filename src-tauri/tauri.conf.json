{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XZ Mods",
  "version": "0.5.0-preview.22.10",
  "identifier": "com.opticmystic.xzmods",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XZ Mods Builder",
        "width": 1240,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/": "resources/"
    },
    "shortDescription": "Standalone XDJ-XZ USB mod and stem preparation",
    "category": "Music",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "XZ Mods",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MDU2NDEzMTlFRUVGODcKUldTSDcrNFpFMlFGU0xQeks3RzcwSjl1bEUzajBIZnAzSGhJcDZJQWZJNGh2Y0lBdHh3ZVd3ZTAK",
      "endpoints": [
        "https://github.com/OpticMystic/XZ-Mods/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
