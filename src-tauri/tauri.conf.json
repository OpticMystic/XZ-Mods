{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XZ Mods",
  "version": "0.1.3",
  "identifier": "com.opticmystic.xzmods",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "XZ Mods Builder", "width": 1120, "height": 820, "minWidth": 900, "minHeight": 680, "create": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../resources/": "resources/" },
    "shortDescription": "Standalone XDJ-XZ USB mod and stem preparation",
    "category": "Music"
  }
}
