+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+class XzMappedMap
+{
+    void *mapping=MAP_FAILED;size_t length=0;
+    static unsigned word(const unsigned char *p){return unsigned(p[0])|unsigned(p[1])<<8|unsigned(p[2])<<16|unsigned(p[3])<<24;}
+public:
+    ~XzMappedMap(){if(mapping!=MAP_FAILED)munmap(mapping,length);}
+    const char *text(unsigned expected){
+        const char *path=getenv("XZ_GZ_MAP_FILE");if(!path)return nullptr;
+        int fd=open(path,O_RDONLY|O_NOFOLLOW);struct stat st;
+        if(fd<0)return nullptr;
+        if(fstat(fd,&st)||!S_ISREG(st.st_mode)||st.st_size<12||st.st_size>128*1024*1024){close(fd);return nullptr;}
+        length=size_t(st.st_size);mapping=mmap(nullptr,length,PROT_READ,MAP_PRIVATE,fd,0);close(fd);
+        if(mapping!=MAP_FAILED)madvise(mapping,length,MADV_SEQUENTIAL);
+        if(mapping==MAP_FAILED)return nullptr;
+        const auto *bytes=static_cast<const unsigned char *>(mapping);
+        if(memcmp(bytes,"PWAD",4))return nullptr;
+        unsigned count=word(bytes+4),directory=word(bytes+8);
+        if(count>65536 || uint64_t(directory)+uint64_t(count)*16>length)return nullptr;
+        for(unsigned i=0;i<count;i++){
+            const auto *entry=bytes+directory+i*16;unsigned offset=word(entry),size=word(entry+4);
+            if(!memcmp(entry+8,"TEXTMAP",7)&&size==expected&&uint64_t(offset)+size<=length)return reinterpret_cast<const char *>(bytes+offset);
+        }
+        return nullptr;
+    }
+};
+
+class XzMapScanner : public FScanner
+{
+public:
+    bool OpenMapView(const char *name, const char *data, unsigned size)
+    {
+        if (!data || !size || data[size-1] != '\n' ||
+            (size>3 && (unsigned char)data[0]==0xef && (unsigned char)data[1]==0xbb && (unsigned char)data[2]==0xbf)) return false;
+        // MapData owns this view throughout UDMFParser's lifetime.
+        // Initialize normal tokenizer state without copying the large map.
+        OpenString(name, "\n");
+        ScriptPtr=data;ScriptEndPtr=data+size;
+        return true;
+    }
+};
